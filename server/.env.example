# copy this file to .env and fill in real values. never commit the real .env

PORT=5000
NODE_ENV=development

# jwt
JWT_SECRET=replace-with-a-long-random-string

# github oauth app (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# must exactly match the "Authorization callback URL" set on the github oauth app
# local dev example: http://localhost:5000/auth/github/callback
# production example: https://your-app.onrender.com/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# base url of the deployed app (used to build redirect targets), no trailing slash
APP_BASE_URL=http://localhost:5000
